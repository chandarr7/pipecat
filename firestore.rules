rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection probe document
    match /test/connection {
      allow read: if true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(operatorId) {
      return isAuthenticated() && request.auth.uid == operatorId;
    }

    function isValidOperator(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'role', 'authType', 'createdAt'])
        && data.id is string
        && data.email is string
        && data.name is string
        && data.role is string
        && data.authType is string;
    }

    function isValidSession(data, operatorId) {
      return data.keys().hasAll(['id', 'operatorId', 'botId', 'state', 'createdAt'])
        && data.id is string
        && data.operatorId == operatorId
        && data.botId is string
        && data.state is string;
    }

    function isValidBusEvent(data, sessionId) {
      return data.keys().hasAll(['id', 'sessionId', 'worker', 'action', 'eventType', 'timestamp'])
        && data.id is string
        && data.sessionId == sessionId
        && data.worker is string
        && data.action is string;
    }

    // Operator profiles
    match /operators/{operatorId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidOperator(request.resource.data);
      allow delete: if isOwner(operatorId);

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isValidSession(request.resource.data, operatorId);
        allow delete: if isOwner(operatorId);

        // Bus events subcollection
        match /bus_events/{eventId} {
          allow read: if isAuthenticated();
          allow create, update: if isAuthenticated() && isValidBusEvent(request.resource.data, sessionId);
          allow delete: if isOwner(operatorId);
        }
      }
    }
  }
}
